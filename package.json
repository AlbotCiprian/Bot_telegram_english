{
  "name": "allengual-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first Telegram bot for Allengual / English Express.",
  "prisma": {
    "schema": "src/db/prisma/schema.prisma",
    "seed": "tsx src/db/prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "ops-bot": "tsx watch src/opsBot.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:ops-bot": "node dist/opsBot.js",
    "prisma:generate": "prisma generate --schema src/db/prisma/schema.prisma",
    "prisma:migrate": "tsx src/db/prisma/applyMigrations.ts",
    "prisma:migrate:dev": "tsx src/db/prisma/applyMigrations.ts",
    "prisma:seed": "tsx src/db/prisma/seed.ts",
    "crawl": "tsx src/crawler/websiteCrawler.ts",
    "embed": "tsx src/crawler/embeddingPipeline.ts",
    "reset:local-state": "tsx src/scripts/resetLocalState.ts",
    "reset:bot-state": "tsx src/scripts/resetLocalState.ts",
    "media:invalidate-cache": "tsx src/scripts/invalidateTelegramMediaCache.ts",
    "media:warm-cache": "tsx src/scripts/warmTelegramMediaCache.ts",
    "stream:build": "tsx src/scripts/buildStreamAssets.ts",
    "stream:verify": "tsx src/scripts/verifyStreamAssets.ts",
    "lessons:reconcile": "tsx src/scripts/reconcileLessons.ts",
    "telegram:logout-cloud": "tsx src/scripts/logoutTelegramCloud.ts",
    "test:e2e-local": "vitest run",
    "audit:local": "tsx src/scripts/auditLocalReadiness.ts",
    "smoke:crm": "tsx src/scripts/smokeCrmFlow.ts",
    "verify:ai": "tsx src/scripts/verifyAi.ts",
    "verify:deepseek": "tsx src/scripts/verifyDeepSeek.ts",
    "verify:telegram": "tsx src/scripts/verifyTelegram.ts",
    "verify:teaching-method": "tsx src/scripts/verifyTeachingMethodMedia.ts",
    "verify:kommo": "tsx src/scripts/verifyKommo.ts",
    "docs:pdf": "md-to-pdf docs/PROJECT_AUDIT.md --stylesheet docs/pdf-theme.css"
  },
  "dependencies": {
    "@fastify/static": "^9.0.0",
    "@prisma/client": "^6.5.0",
    "axios": "^1.8.4",
    "bullmq": "^5.12.15",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "hls.js": "^1.6.15",
    "ioredis": "^5.4.2",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "telegraf": "^4.16.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "md-to-pdf": "^5.2.5",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
