{
  "name": "allengual-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first Telegram bot for Allengual / English Express.",
  "prisma": {
    "schema": "src/db/prisma/schema.prisma",
    "seed": "tsx src/db/prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate --schema src/db/prisma/schema.prisma",
    "prisma:migrate": "tsx src/db/prisma/applyMigrations.ts",
    "prisma:migrate:dev": "tsx src/db/prisma/applyMigrations.ts",
    "prisma:seed": "tsx src/db/prisma/seed.ts",
    "crawl": "tsx src/crawler/websiteCrawler.ts",
    "embed": "tsx src/crawler/embeddingPipeline.ts",
    "test:e2e-local": "vitest run",
    "verify:ai": "tsx src/scripts/verifyAi.ts",
    "verify:deepseek": "tsx src/scripts/verifyDeepSeek.ts",
    "verify:telegram": "tsx src/scripts/verifyTelegram.ts",
    "verify:kommo": "tsx src/scripts/verifyKommo.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "axios": "^1.8.4",
    "bullmq": "^5.12.15",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "telegraf": "^4.16.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
